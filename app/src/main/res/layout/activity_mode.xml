<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ModeActivity">

  <TextView
      android:id="@+id/title_mode"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="48dp"
      android:fontFamily="serif-monospace"
      android:textAllCaps="false"
      android:textColor="#10A441"
      android:textSize="30sp"
      android:text="Choisir un mode de jeu"
      android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.498"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_chainStyle="packed" />

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/buttons_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintTop_toBottomOf="@id/title_mode"
      app:layout_constraintBottom_toTopOf="@+id/btn_endless"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <Button
        android:id="@+id/btn_30"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:paddingVertical="16dp"
        android:text="30s"
        android:textColor="#F8F8F8"
        android:textSize="20sp"
        android:backgroundTint="#F0789C"
        android:tooltipText="Faites le maximum de points dans une partie de 30 secondes"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_45"
        app:layout_constraintHorizontal_chainStyle="packed" />
    <!-- MODIFICATION: chainStyle="packed" et layout_width="wrap_content" -->

    <Button
        android:id="@+id/btn_45"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="16dp"
        android:text="45s"
        android:textColor="#F8F8F8"
        android:textSize="20sp"
        android:backgroundTint="#FFC107"
        android:tooltipText="Faites le maximum de points dans une partie de 45 secondes"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="@id/btn_30"
        app:layout_constraintStart_toEndOf="@+id/btn_30"
        app:layout_constraintEnd_toStartOf="@+id/btn_60" />

    <Button
        android:id="@+id/btn_60"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:paddingVertical="16dp"
        android:backgroundTint="#8BC34A"
        android:text="60s"
        android:textColor="#F8F8F8"
        android:textSize="20sp"
        android:tooltipText="Faites le maximum de points dans une partie de 60 secondes"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="@id/btn_30"
        app:layout_constraintStart_toEndOf="@+id/btn_45"
        app:layout_constraintEnd_toEndOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <Button
      android:id="@+id/btn_endless"
      android:layout_width="266dp"
      android:layout_height="60dp"
      android:layout_marginBottom="72dp"
      android:backgroundTint="#11AD36"
      android:text="Mode Endless"
      android:tooltipText="Faites le maximum de points dans une partie sans fin"
      app:cornerRadius="5dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.498"
      app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>